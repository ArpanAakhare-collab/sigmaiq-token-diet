rules_version = '2';
service cloud.firestore {
  match /databases/{database}/documents {
    
    // Users profile collection
    match /users/{userId} {
      allow read, write: if request.auth != null && request.auth.uid == userId;
    }

    // User-owned Projects
    match /projects/{projectId} {
      allow create: if request.auth != null && request.resource.data.ownerUid == request.auth.uid;
      allow read, delete: if request.auth != null && resource.data.ownerUid == request.auth.uid;
      allow update: if request.auth != null && resource.data.ownerUid == request.auth.uid && request.resource.data.ownerUid == request.auth.uid;
    }

    // User-owned Datasets
    match /datasets/{datasetId} {
      allow create: if request.auth != null && request.resource.data.ownerUid == request.auth.uid;
      allow read, delete: if request.auth != null && resource.data.ownerUid == request.auth.uid;
      allow update: if request.auth != null && resource.data.ownerUid == request.auth.uid && request.resource.data.ownerUid == request.auth.uid;
    }

    // User-owned Runs
    match /runs/{runId} {
      allow create: if request.auth != null && request.resource.data.ownerUid == request.auth.uid;
      allow read, delete: if request.auth != null && resource.data.ownerUid == request.auth.uid;
      allow update: if request.auth != null && resource.data.ownerUid == request.auth.uid && request.resource.data.ownerUid == request.auth.uid;
    }

    // User-owned Query Results
    match /query_results/{resultId} {
      allow create: if request.auth != null && request.resource.data.ownerUid == request.auth.uid;
      allow read, delete: if request.auth != null && resource.data.ownerUid == request.auth.uid;
      allow update: if request.auth != null && resource.data.ownerUid == request.auth.uid && request.resource.data.ownerUid == request.auth.uid;
    }

    // User-owned Benchmarks
    match /benchmarks/{bmId} {
      allow create: if request.auth != null && request.resource.data.ownerUid == request.auth.uid;
      allow read, delete: if request.auth != null && resource.data.ownerUid == request.auth.uid;
      allow update: if request.auth != null && resource.data.ownerUid == request.auth.uid && request.resource.data.ownerUid == request.auth.uid;
    }

    // User-owned Settings
    match /settings/{docId} {
      allow create: if request.auth != null && request.resource.data.ownerUid == request.auth.uid;
      allow read, delete: if request.auth != null && resource.data.ownerUid == request.auth.uid;
      allow update: if request.auth != null && resource.data.ownerUid == request.auth.uid && request.resource.data.ownerUid == request.auth.uid;
    }

    // User-owned Audit Logs
    match /audit_logs/{logId} {
      allow create: if request.auth != null && request.resource.data.ownerUid == request.auth.uid;
      allow read: if request.auth != null && resource.data.ownerUid == request.auth.uid;
    }
  }
}
